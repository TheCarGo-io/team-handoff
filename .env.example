# The address your team reaches the server at. Invite links and the plugin use it.
PUBLIC_URL=http://localhost:8080
PORT=8080
DB_PASSWORD=change-me

# Teams created on the first start. Admins add more later by inviting someone into a new team.
TEAMS=backend,frontend,mobile,design

# Optional. Limit report projects to these repository names, and map other spellings onto them.
# PROJECTS=web-app,api,mobile-app
# PROJECT_ALIASES={"frontend":"web-app"}

# Optional. Use an existing PostgreSQL instead of the bundled one (outside docker compose).
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/handoff
